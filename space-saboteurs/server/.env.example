# Port the game server listens on. Render/Railway/Fly set this for you in
# production; locally it defaults to 3001 if unset.
PORT=3001

# Comma-separated list of allowed frontend origins for Socket.IO CORS.
# Include both your local dev URL and your production Vercel URL.
CLIENT_ORIGIN=http://localhost:3000,https://space-saboteurs.vercel.app
